# marrow_server — environment variables
# Copy this file to .env and fill in the required values

# --- REQUIRED ---

# Authentication token for MCP and REST API requests
SECRET_TOKEN=change-me-to-a-strong-random-secret

# Root directory where project artifact workspaces are stored
TASKS_DIR=/path/to/your/data

# --- OPTIONAL ---

# Embedding models (defaults shown)
EMBEDDING_MODEL_CODE=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_TEXT=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
MAX_EMBED_CHARS=2000

# fastembed model cache directory (Docker only).
# Point this at a path inside a persistent volume so the downloaded model
# survives container restarts.  Leave UNSET for local / Windows dev —
# fastembed will use its own OS-appropriate default automatically.
# FASTEMBED_CACHE_DIR=/root/.cache/huggingface/fastembed

# Vectorization debounce (seconds)
VECT_DEBOUNCE_SECONDS=0.5

# --- SERVER BINDING ---

# Bind address (default: 0.0.0.0 — required for Docker/hosted deployments)
# Uncomment the line below for local-only access (loopback):
# HOST=127.0.0.1

# HTTP port (default: 8000)
# PORT=8000
