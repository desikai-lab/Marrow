# marrow_worker — environment variables
# Copy this file to .env and fill in the required values

# --- REQUIRED ---

# URL of the running marrow_server
SERVER_URL=http://localhost:8000

# Must match the SECRET_TOKEN set in marrow_server
SECRET_TOKEN=change-me-to-a-strong-random-secret

# Root path to watch (all subdirectories will be scanned)
WATCH_ROOT=/path/to/your/source/code

# --- OPTIONAL ---

# File change debounce interval in seconds
DEBOUNCE_SECONDS=1.0

# Max skeleton chunks per delivery batch
BATCH_SIZE=50

# Must match marrow_server embedding settings
EMBEDDING_MODEL_CODE=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
